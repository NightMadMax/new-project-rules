# Ключи `.dev.env`, которые читают проверки самого стандарта.
#
# Второй файл-образец, `.dev.env.example`, приходит из upstream побайтно и
# описывает параметры его инструментов: платформа, база, пути, учётные данные.
# Здесь — только то, что спрашивают `doctor-1c`, `setup-1c-environment` и
# обнаружение MCP-провайдера. Разделение не по вкусу: upstream-файл переносится
# без изменений, поэтому дописать в него наши ключи нельзя, а объявить их
# где-то ещё — значит, что диагностика будет спрашивать ключи, которых нет ни в
# одном полученном образце.
#
# Собрать `.dev.env`: скопировать оба образца в один файл. `.dev.env` не
# отслеживается git — он может содержать dev- и test-учётные данные.
# Production-паролям здесь не место.

# Чего машина о себе не сообщает. EDT называет свой релиз сама, а плагин, патч
# и токен живут внутри установок, которые диагностике обходить нельзя, — поэтому
# состояние записывается сюда. Пустой ключ означает «не записано», а не «не
# установлено»; отчёт называет именно это различие.
EDT_MCP_VERSION=
EDT_ORDINARY_PLUGIN=
EDT_RUN_WITHOUT_UPDATE=
YAXUNIT_EXTENSION=
NAPARNIK_TOKEN=

# Путь к manifest внешнего MCP-провайдера. Обнаружение читает только объявленный
# здесь путь: угаданный либо промахнётся, либо подхватит устаревший manifest от
# посторонней установки. Сам путь в отчёт не выводится.
MCP_PROVIDER_MANIFEST=
