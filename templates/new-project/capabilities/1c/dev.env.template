# Local settings for 1C tooling. Gitignored: it may hold dev and test
# credentials. Production passwords do not belong here.
#
# Copy of the upstream template shipped with the capability. The capability
# creates this file only when it is missing and never overwrites values.

V8_VERSION=
V8_PATH=
DEFAULT_BASE=
DEFAULT_USER=
DEFAULT_PASSWORD=

ORCHESTRATION=
VERIFICATION_DEPTH=
UI_TESTING=
CAVEMAN=

# What the machine does not report about itself. EDT names its own release, but
# a plugin, a patch and a token live inside installations the diagnosis may not
# walk, so `doctor-1c` reads them here. An empty key means "not recorded", not
# "not installed" — the report says which of the two it is by naming the key.
EDT_MCP_VERSION=
EDT_ORDINARY_PLUGIN=
EDT_RUN_WITHOUT_UPDATE=
YAXUNIT_EXTENSION=
NAPARNIK_TOKEN=

# Path to the manifest of the external MCP provider. Discovery reads only the
# path declared here: a guessed one would either miss or pick up a stale
# manifest from an unrelated install. The path itself never reaches a report.
MCP_PROVIDER_MANIFEST=
